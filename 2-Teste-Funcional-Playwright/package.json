{
  "name": "atividade-playwright-frete-conta",
  "version": "1.0.0",
  "private": true,
  "description": "Testes funcionais com Playwright - telas de frete e conta",
  "scripts": {
    "start": "node server.js",
    "browsers": "playwright install chromium",
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --headed --project=chromium",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
